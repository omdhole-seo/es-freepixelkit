# Provide unique, strong values through your local/server environment.
# ADMIN_PASSWORD must have at least 16 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Use a persistent writable directory for a self-hosted, single-instance Node server.
BLOG_DATA_DIR=./data
BLOG_UPLOAD_DIR=./data/blog-uploads
NEXT_PUBLIC_SITE_URL=https://es.freepixelkit.com
